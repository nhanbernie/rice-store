{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 100,
  "arrowParens": "always",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "jsxBracketSameLine": false,
  "proseWrap": "never",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.svg"],
      "options": {
        "printWidth": 0,
        "bracketSpacing": false,
        "singleQuote": false
      }
    }
  ]
}
