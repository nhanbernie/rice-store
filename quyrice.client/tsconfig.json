{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/messages/*": ["./src/common/constants/messages/*"],
      "@/sizes/*": ["./src/common/constants/styles/sizes/*"],
      "@/colors/*": ["./src/common/constants/styles/colors/*"],
      "@/icons/*": ["./src/common/constants/styles/icons/*"],
      "@/styles/*": ["./src/common/constants/styles/*"],
      "@/components/*": ["./src/components/*"],
      "@/models/*": ["./src/common/models/*"],
      "@/motions/*": ["./src/components/aminations/*"],
      "@/utils/*": ["./src/utils/*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
